@article{kawazumi,
	title = {Homology of hyperelliptic mapping class groups for surfaces},
	journal = {Topology and its Applications},
	volume = {76},
	number = {3},
	pages = {203-216},
	year = {1997},
	issn = {0166-8641},
	doi = {https://doi.org/10.1016/S0166-8641(96)00105-8},
	url = {https://www.sciencedirect.com/science/article/pii/S0166864196001058},
	author = {Nariya Kawazumi},
	keywords = {Mapping class groups, Moduli of curves, Hyperelliptic curve, Cohomology of groups, Morita-Mumford classes},
	abstract = {The cohomology of the hyperelliptic mapping class group of genus g with coefficients in any field has been determined by Boedigheimer-Cohen-Peim. We give an alternative, more geometric and elementary way to compute it when the characteristic of the field is greater than g.}
}

@article{margalit,
	author = {Margalit, Dan and Winarski, Rebecca R.},
	title = {Braid groups and mapping class groups: The Birman–Hilden theory},
	journal = {Bulletin of the London Mathematical Society},
	volume = {53},
	number = {3},
	pages = {643-659},
	keywords = {57M12, 57M60 (primary)},
	doi = {https://doi.org/10.1112/blms.12456},
	url = {https://londmathsoc.onlinelibrary.wiley.com/doi/abs/10.1112/blms.12456},
	eprint = {https://londmathsoc.onlinelibrary.wiley.com/doi/pdf/10.1112/blms.12456},
	abstract = {Abstract In the 1970s, Joan Birman and Hugh Hilden wrote several papers on the problem of relating the mapping class group of a surface to that of a covering space. Their results provide a bridge between the theories of mapping class groups and braid groups. We survey the work of Birman and Hilden, give an overview of the subsequent developments, and discuss open questions and new directions.},
	year = {2021}
}

